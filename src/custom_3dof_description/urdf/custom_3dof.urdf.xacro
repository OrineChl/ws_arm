<?xml version="1.0"?>
<robot name="custom_3dof" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="materials.xacro"/>

  <!-- 权威参考：ws_arm_base/bsp/manipulator/kinematics.c（底层固件）。
       约定：底层不准修改，上层仿真按底层对齐（2026-09-08）。
       本 URDF 与底层正向运动学逐位一致（随机位形对拍误差 < 1e-15 m）：
         T = T_car(x,y,phi) · T_base(0.085,0,0.24) · MDH(theta1,theta2,theta3)
       三个运动关节，正角度 = 底层 theta 正方向 = 电机反馈角 ÷ 减速比：
         joint1 = theta1（电机 Joint_1，减速比 3）
         joint2 = theta2（电机 Joint_2 + Joint_3 镜像驱动，减速比 6）
         joint3 = theta3（电机 Joint_4，减速比 4.8）
       腕部在底层 FK 中无自由度：joint4 为固定连接；腕部舵机(Joint_5)与夹爪(Joint_6)不在链内。
       所有长度单位 m，角度 rad；零位 = 工程图姿态，q=0 时 tcp 在 base_link 系 (0.264, 0, 0.372)。 -->

  <xacro:property name="j1_to_j2" value="0.161"/>
  <xacro:property name="j2_to_j3" value="0.191"/>
  <!-- 肘部到腕部分界 0.172，腕部到 TCP 0.092，合计 0.264，与底层 d6+d7=0.086+0.178 一致 -->
  <xacro:property name="j3_to_wrist" value="0.172"/>
  <xacro:property name="wrist_length" value="0.092"/>
  <!-- PROVISIONAL drawing estimates, NOT calibrated TCP dimensions. -->
  <xacro:property name="tcp_z_provisional" value="0.020"/>
  <!-- 臂在底盘上的安装偏置 = kinematics.c 的 base_offset -->
  <xacro:property name="arm_mount_x" value="0.085"/>
  <xacro:property name="arm_mount_z" value="0.24"/>
  <!-- Illustrative geometry dimensions only; not measured hardware envelopes. -->
  <xacro:property name="base_radius" value="0.055"/>
  <xacro:property name="base_height" value="0.018"/>
  <xacro:property name="column_radius" value="0.023"/>
  <xacro:property name="arm_width" value="0.028"/>
  <xacro:property name="wrist_width" value="0.018"/>

  <xacro:macro name="box_link" params="name size xyz material">
    <link name="${name}">
      <visual><origin xyz="${xyz}"/><geometry><box size="${size}"/></geometry><material name="${material}"/></visual>
      <collision><origin xyz="${xyz}"/><geometry><box size="${size}"/></geometry></collision>
    </link>
  </xacro:macro>
  <xacro:macro name="cylinder_link" params="name radius length z material">
    <link name="${name}">
      <visual><origin xyz="0 0 ${z}"/><geometry><cylinder radius="${radius}" length="${length}"/></geometry><material name="${material}"/></visual>
      <collision><origin xyz="0 0 ${z}"/><geometry><cylinder radius="${radius}" length="${length}"/></geometry></collision>
    </link>
  </xacro:macro>

  <!-- ===== 底盘层：镜像底层 q[0..2] = [x, y, phi]（固件当前硬编码为 0，world 与 chassis 重合）。
       T_car = Trans(x,y)·RotZ(phi)；KDL 不支持 planar 关节，拆成三个单元关节。
       car_x/car_y 的 limit 仅为 RViz 滑块可视化范围，不是任何物理限位。 ===== -->
  <link name="world"/>
  <link name="car_x"/>
  <link name="car_y"/>
  <link name="chassis"/>
  <joint name="car_x_joint" type="prismatic">
    <parent link="world"/><child link="car_x"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit effort="0" velocity="0" lower="-5" upper="5"/>
  </joint>
  <joint name="car_y_joint" type="prismatic">
    <parent link="car_x"/><child link="car_y"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit effort="0" velocity="0" lower="-5" upper="5"/>
  </joint>
  <joint name="car_yaw_joint" type="continuous">
    <parent link="car_y"/><child link="chassis"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
  </joint>

  <joint name="arm_mount_joint" type="fixed">
    <parent link="chassis"/><child link="base_link"/>
    <origin xyz="${arm_mount_x} 0 ${arm_mount_z}" rpy="0 0 0"/>
  </joint>

  <xacro:cylinder_link name="base_link" radius="${base_radius}" length="${base_height}" z="${base_height/2}" material="base_gray"/>
  <xacro:cylinder_link name="link1" radius="${column_radius}" length="${j1_to_j2}" z="${j1_to_j2/2}" material="base_gray"/>
  <xacro:box_link name="link2" size="${arm_width} ${arm_width} ${j2_to_j3}" xyz="0 0 ${j2_to_j3/2}" material="arm_blue"/>
  <xacro:box_link name="link3" size="${j3_to_wrist} ${arm_width} ${arm_width}" xyz="${j3_to_wrist/2} 0 0" material="elbow_orange"/>
  <xacro:box_link name="link4" size="${wrist_length} ${wrist_width} ${wrist_width}" xyz="${wrist_length/2} 0 0" material="wrist_green"/>
  <link name="tool0"/>
  <link name="tcp"/>

  <!-- TODO: joint1-joint3 are temporarily continuous for RViz only.
       Bottom-layer software limits exist (manipulator.c: [-90,90]/[0,90]/[-90,0] deg),
       but mechanical limits are still unmeasured; change to revolute only with real limits.
       Position, velocity and effort limits are unknown; do not invent them. -->
  <!-- 轴方向由底层 MDH 链对拍确定：joint2/joint3 为 (0,1,0)（旧版 (0,-1,0) 与底层反号，已翻转）。 -->
  <joint name="joint1" type="continuous">
    <parent link="base_link"/><child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <joint name="joint2" type="continuous">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0 0 ${j1_to_j2}" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="joint3" type="continuous">
    <parent link="link2"/><child link="link3"/>
    <origin xyz="0 0 ${j2_to_j3}" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>
  <!-- 腕部固定（底层 FK 中固定）：joint4 由 revolute 改为 fixed，保持链命名不变 -->
  <joint name="joint4" type="fixed">
    <parent link="link3"/><child link="link4"/>
    <origin xyz="${j3_to_wrist} 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="link4_to_tool0" type="fixed">
    <parent link="link4"/><child link="tool0"/><origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="tool0_to_tcp" type="fixed">
    <parent link="tool0"/><child link="tcp"/>
    <origin xyz="${wrist_length} 0 ${tcp_z_provisional}" rpy="0 0 0"/>
  </joint>
</robot>
